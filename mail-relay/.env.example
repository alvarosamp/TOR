# Domínio (ex.: relay.tor.tec.br) apontado no DNS para o IP do VPS da Hostinger. O HTTPS é automático.
RELAY_DOMAIN=relay.seu-dominio.com.br

# Segredo compartilhado com o PHP da Locaweb (gere com: openssl rand -hex 32)
RELAY_TOKEN=

# SMTP da Hostinger (caixa de e-mail criada no hPanel)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=site@seu-dominio.com.br
SMTP_PASS=
MAIL_FROM="Site TOR Tecnologia" <site@seu-dominio.com.br>

RATE_LIMIT_PER_MIN=30
